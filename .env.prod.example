# Copy to .env.prod and fill every value. NEVER commit .env.prod.
# Read by docker-compose.prod.yml (API and migration job).

# --- Managed PostgreSQL ---------------------------------------------------
# Owner role: used only by the migration job (migrations, grants, seed).
DATABASE_URL="postgresql://OWNER_ROLE:OWNER_PASSWORD@db.example.internal:5432/hares?sslmode=require"
# Runtime role the API connects as. The migration job creates it (or resets its
# password) from this URL, so the name and password here ARE the role's.
APP_DATABASE_URL="postgresql://hares_app:A_LONG_RANDOM_PASSWORD@db.example.internal:5432/hares?sslmode=require"

# --- First System Administrator (seed; used once, when none exists) --------
INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="admin@your-organisation.example"
# At least 8 characters with upper, lower, digit and symbol. Change it after the first sign-in.
INITIAL_ADMIN_PASSWORD="CHANGE_ME"

# --- API -------------------------------------------------------------------
# REQUIRED: at least 32 random characters, e.g.: openssl rand -base64 48 (the API refuses to start without one)
JWT_ACCESS_SECRET=""
# The public https address of the web app (CORS, cookies, links in emails).
WEB_BASE_URL="https://hares.your-organisation.example"
CORS_ORIGIN="https://hares.your-organisation.example"
# The nginx in the web container is the one proxy the API trusts: it writes the client address itself
# (it never forwards a client-supplied X-Forwarded-For). Keep 1. If a load balancer sits in front, list its
# address in ops/nginx.conf (set_real_ip_from), not here.
TRUST_PROXY="1"

# --- Mail (password reset) -------------------------------------------------
SMTP_HOST="smtp.your-organisation.example"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="CHANGE_ME"
SMTP_PASS="CHANGE_ME"
MAIL_FROM="Hares AI <no-reply@your-organisation.example>"

# --- Optional --------------------------------------------------------------
# The web port is published on this address only (default: the host itself, for a reverse proxy / load
# balancer on the same machine). Use 0.0.0.0 only when nothing else sits in front.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080
