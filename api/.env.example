# Copy this file to .env and change every value before use.
DATABASE_URL="postgresql://user:password@localhost:5432/hares"
APP_DATABASE_URL="postgresql://app_user:app_password@localhost:5432/hares"

INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL="sysadmin@example.com"
INITIAL_ADMIN_PASSWORD="CHANGE_ME"

# Signs web/extension access JWTs (HS256). At least 32 random characters.
JWT_ACCESS_SECRET="CHANGE_ME_TO_32_PLUS_RANDOM_CHARACTERS"
# Optional: force the refresh cookie Secure flag (true/false). Default: Secure only in production.
# COOKIE_SECURE="true"

# Mail (password reset). Defaults to Mailpit from docker-compose.dev.yml.
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Hares AI <no-reply@hares.local>"
# Public web origin used in emailed links.
# WEB_BASE_URL="http://localhost:1420"
# Behind the reverse proxy in production set TRUST_PROXY="1".
# TRUST_PROXY=""
